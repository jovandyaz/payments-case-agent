{
  "name": "payments-case-agent",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p scripts/tsconfig.json && pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test:unit": "vitest run --project unit --project console",
    "test:hooks": "node --test \".claude/hooks/__tests__/*.test.mjs\"",
    "verify": "pnpm typecheck && pnpm lint && pnpm test:unit && pnpm test:hooks",
    "test": "vitest run && pnpm test:hooks",
    "start": "node scripts/dev/start.ts",
    "stop": "node scripts/dev/stop.ts",
    "reset": "node scripts/dev/reset.ts",
    "canary:inject": "pnpm --filter @payments-case-agent/api canary:inject",
    "demo:post": "pnpm --filter @payments-case-agent/api demo:post",
    "ops:scan-logs": "pnpm --filter @payments-case-agent/api ops:scan-logs",
    "ops:scan-traces": "pnpm --filter @payments-case-agent/api ops:scan-traces",
    "e2e": "pnpm --filter @payments-case-agent/e2e e2e",
    "e2e:isolated": "node scripts/dev/e2e-isolated.ts",
    "eval": "pnpm --filter @payments-case-agent/evals eval",
    "eval:agreement": "pnpm --filter @payments-case-agent/evals eval:agreement",
    "eval:carry-labels": "pnpm --filter @payments-case-agent/evals eval:carry-labels",
    "eval:judgments": "pnpm --filter @payments-case-agent/evals eval:judgments",
    "eval:rejudge": "pnpm --filter @payments-case-agent/evals eval:rejudge",
    "eval:report": "pnpm --filter @payments-case-agent/evals eval:report"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "lefthook": "2.2.2",
    "prettier": "^3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
